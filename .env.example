# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored, so secrets never reach GitHub.

# MySQL – use the dedicated app account from database/05_app_user.sql, not root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=resort_app
DB_PASSWORD=change-me
DB_NAME=resort_entries

# Neo4j Aura – values from the credentials file you download when creating the instance
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Secret used to sign login cookies (JWT). Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
